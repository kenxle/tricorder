{
  "name": "@tricorder/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --localhost --dev-client --android",
    "ios": "expo start --localhost --dev-client --ios",
    "web": "expo start --localhost --web",
    "lint": "expo lint",
    "dev": "expo start --localhost --dev-client",
    "build": "expo export --platform all",
    "typecheck": "tsc --noEmit",
    "build:ios": "expo run:ios --no-bundler",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.23",
    "@tricorder/schema": "workspace:*",
    "expo": "~58.0.19",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-mail-composer": "~58.0.3",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  }
}
