# Copy to .env and fill in. Never commit .env. Every variable is described in
# docs/ongoing/ARCHITECTURE.md, "Environment variables".

# Model calls
ANTHROPIC_API_KEY=
TRICORDER_MODEL_READ=claude-opus-5-5
TRICORDER_MODEL_BULK=claude-haiku-5-5
TRICORDER_LLM_BASE_URL=

# Running
TRICORDER_OFFLINE=
TRICORDER_OUT_DIR=
TRICORDER_SETTINGS=
# The readout store (default store_data/) and the outside-data cache (default cache/)
TRICORDER_STORE_DIR=
TRICORDER_CACHE_DIR=
# Arriving rooms and working copies (default rooms/), and the largest file a founder's reply may add
TRICORDER_ROOMS_DIR=
TRICORDER_UPLOAD_MAX_MB=25
# The sign-off on a request to the founder, and who a steer is credited to
TRICORDER_OPERATOR_NAME=
TRICORDER_FUND_NAME=
TRICORDER_OPERATOR=
# script keeps the contract check on the script reader
TRICORDER_CONTRACT_READER=

# The pitch video
WHISPER_CPP_BIN=
WHISPER_MODEL_PATH=

# Outside data
EDGAR_USER_AGENT=
AKTA_API_KEY=
TAVILY_API_KEY=
YOU_API_KEY=
GITHUB_TOKEN=
PRODUCT_HUNT_TOKEN=
CRUNCHBASE_API_KEY=
NICRRON_API_KEY=
OPENAI_API_KEY=

# The inbox
INBOUND_WEBHOOK_SECRET=

# The bank check
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
