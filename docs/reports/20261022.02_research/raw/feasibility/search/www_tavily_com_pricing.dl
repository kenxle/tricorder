iceUnit\":\"/month\",\"tagColor\":\"orange\"},{\"_key\":\"f90eb37a437f\",\"description\":\"For corporations\",\"features\":[{\"_key\":\"8035902a1ed9\",\"text\":\"Custom API calls\"},{\"_key\":\"429660f76d8b\",\"text\":\"Custom rate limits\"},{\"_key\":\"b3159e9c3ca7\",\"text\":\"Enterprise-grade support and SLAs\"},{\"_key\":\"9b22b4917381\",\"text\":\"Enterprise-grade security and privacy\"}],\"hasSlider\":false,\"link\":{\"externalLink\":{\"newWindow\":true,\"url\":\"/contact\"},\"internalLink\":null,\"linkType\":\"external\",\"text\":\"Talk to the team\"},\"planName\":\"Enterprise\",\"price\":\"Custom\",\"priceUnit\":null,\"tagColor\":\"purple\"}],\"startupCardDescription\":\"Get 100k free API credits, hands-on support from our team, and help bringing your product to market.\",\"startupCardHeading\":\"Building a startup?\",\"startupCardLink\":{\"externalLink\":{\"newWindow\":false,\"url\":\"/startups\"},\"internalLink\":null,\"linkType\":\"external\",\"text\":\"Join the program\"},\"studentCardDescription\":\"We're dedicated to supporting the pursuit of knowledge\\nby offering our service at no cost for students.\",\"studentCardHeading\":\"Free for students\",\"studentCardLink\":{\"externalLink\":{\"newWindow\":true,\"url\":\"https://help.tavily.com/articles/6606514713-student-account\"},\"internalLink\":null,\"linkType\":\"external\",\"text\":\"Start exploring\"}},{\"_key\":\"fb400e03832a\",\"_type\":\"module.faq\",\"contactButton\":{\"externalLink\":{\"newWindow\":true,\"url\":\"/contact\"},\"internalLink\":null,\"linkType\":\"external\",\"text\":\"Contact us\"},\"description\":\"If you have any questions, please reach out to our team!\",\"eyebrow\":\"/faq\",\"faqItems\":[{\"_key\":\"acc9bb359811\",\"answer\":\"Sign up for a free account and get your API key from the dashboard, this key authenticates all API requests.\\n\\nInstall the SDK (e.g., Python or JavaScript) and plug in your API key to start making calls.You start with 1,000 free API credits per month with no credit card required.\",\"question\":\"How do I start using Tavily and get an API key?\"},{\"_key\":\"6f42a7ed7e7b380ce5f1cc72b0041499\",\"answer\":\"Your API credits reset on the first day of each month, regardless of the billing date. This ensures you start each month with a clean slate of credits to use for your searches.\",\"question\":\"When do my monthly API credits reset?\"},{\"_key\":\"9fb1a9b98c8163a1313dd7c57b8534f7\",\"answer\":\"API credits are consumed based on the type of request you make (such as search, extract, or crawl). More advanced or higher-volume requests use more credits. Full usage details are available in the documentation.\",\"question\":\"What is an API credit and how is usage calculated?\"},{\"_key\":\"0b8d92f65a293e6c45befca084b4c893\",\"answer\":\"If you exhaust your monthly credits, requests will stop until your credits reset or you upgrade to a paid plan. Paid plans provide higher monthly limits and uninterrupted usage.\",\"question\":\"What happens if I run out of credits?\"}],\"heading\":\"Frequently asked questions\"}]}]]\n11:null\n17:[[\"$\",\"title\",\"0\",{\"children\":\"Tavily Pricing\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Find Tavily pricing that scales with you: free credits to start, pay-as-you-go flexibility, or a custom enterprise plan.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"4\",{\"name\":\"apple-mobile-web-app-title\",\"content\":\"Tavily\"}],[\"$\",\"meta\",\"5\",{\"name\":\"apple-mobile-web-app-status-bar-style\",\"content\":\"default\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:title\",\"content\":\"Tavily Pricing\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:description\",\"content\":\"Find Tavily pricing that scales with you: free credits to start, pay-as-you-go flexibility, or a custom enterprise plan.\"}],[\"$\",\