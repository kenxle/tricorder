s="QdTX5q_button QdTX5q_secondary QdTX5q_fullWidth"><span class="QdTX5q_content"><span class="QdTX5q_label">Get started</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div></div><div class="B944rW_card" style="--plan-accent:var(--color-pink)"><div class="B944rW_tagArea"><h2 class="B944rW_planName">Pay As You Go</h2></div><div class="B944rW_priceArea"><div class="B944rW_priceRow"><p class="B944rW_price">$0.008</p><span class="B944rW_priceUnit"> / credit</span></div><p class="B944rW_description">For flexible usage</p></div><div class="B944rW_separatorArea"><div class="B944rW_divider"></div></div><ul class="B944rW_featuresArea"><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Pay only for what you use</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Cancel anytime</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Email support</span></li></ul><div class="B944rW_buttonArea"><a href="https://app.tavily.com/home" target="_blank" rel="noopener noreferrer" class="QdTX5q_button QdTX5q_secondary QdTX5q_fullWidth"><span class="QdTX5q_content"><span class="QdTX5q_label">Get started</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div></div><div class="B944rW_card" style="--plan-accent:var(--color-yellow)"><div class="B944rW_tagArea"><h2 class="B944rW_planName">Project</h2></div><div class="B944rW_priceArea"><div class="B944rW_priceRow"><p class="B944rW_price"><span class="B944rW_screenReaderPrice">$30</span><span class="B944rW_slotPriceWrapper" aria-hidden="true"><span class="B944rW_slotCurrencySymbol">$</span><span class="B944rW_slotDigitWrapper"><span class="B944rW_slotReel" style="transform:translateY(-30%);transition-property:transform;transition-duration:0.6s;transition-timing-function:ease-in-out;transition-delay:0s"><span class="B944rW_slotDigitItem">0</span><span class="B944rW_slotDigitItem">1</span><span class="B944rW_slotDigitItem">2</span><span class="B944rW_slotDigitItem">3</span><span class="B944rW_slotDigitItem">4</span><span class="B944rW_slotDigitItem">5</span><span class="B944rW_slotDigitItem">6</span><span class="B944rW_slotDigitItem">7</span><span class="B944rW_slotDigitItem">8</span><span class="B944rW_slotDigitItem">9</span></span></span><span class="B944rW_slotDigitWrapper"><span class="B944rW_slotReel" style="transform:translateY(0%);transition-property:transform;transition-duration:0.6s;transition-timing-function:ease-in-out;transition-delay:0.05s"><span class="B944rW_slotDigitItem">0</span><span class="B944rW_slotDigitItem">1</span><span class="B944rW_slotDigitItem">2</span><span class="B944rW_slotDigitItem">3</span><span class="B944rW_slotDigitItem">4</span><span class="B944rW_slotDigitItem">5</span><span class="B944rW_slotDigitItem">6</span><span class="B944rW_slotDigitItem">7</span><span class="B944rW_slotDigitItem">8</span><span class="B944rW_slotDigitItem">9</span></span></span></span></p><span class="B944rW_priceUnit"> / month</span></div><p class="B944rW_description">Built for enthusiasts</p></div><div class="B944rW_separatorArea"><div class="B944rW_sliderWrapper"><input type="range" aria-label="Subscription plan" aria-valuetext="Project, $30 per month" min="1" max="4" step="1" class="B944rW_sliderInput" style="background:linear-gradient(to right, var(--color-black) 0%, var(--color-black) 0%, var(--color-black-20) 0%, var(--color-black-20) 100%)" value="1"/><p class="B944rW_sliderLabel">Slide to adjust plan</p></div></div><ul class="B944rW_featuresArea"><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">4,000 API credits / month</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Higher rate limits</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Email support</span></li></ul><div class="B944rW_buttonArea"><a href="https://app.tavily.com/home" target="_blank" rel="noopener noreferrer" class="QdTX5q_button QdTX5q_primary QdTX5q_fullWidth"><span class="QdTX5q_content"><span class="QdTX5q_label">Get started</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div></div><div class="B944rW_card" style="--plan-accent:var(--color-lav)"><div class="B944rW_tagArea"><h2 class="B944rW_planName">Enterprise</h2></div><div class="B944rW_priceArea"><div class="B944rW_priceRow"><p class="B944rW_price">Custom</p></div><p class="B944rW_description">For corporations</p></div><div class="B944rW_separatorArea"><div class="B944rW_divider"></div></div><ul class="B944rW_featuresArea"><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Custom API calls</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Custom rate limits</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Enterprise-grade support and SLAs</span></li><li class="B944rW_feature"><span class="B944rW_featureMarker" aria-hidden="true"></span><span class="B944rW_featureText">Enterprise-grade security and privacy</span></li></ul><div class="B944rW_buttonArea"><a class="QdTX5q_button QdTX5q_secondary QdTX5q_fullWidth" href="/contact"><span class="QdTX5q_content"><span class="QdTX5q_label">Talk to the team</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div></div></div><div class="B944rW_programs"><div class="B944rW_programCard" style="--plan-accent:var(--color-green)"><div class="B944rW_programContent"><h2 class="B944rW_programHeading">Building a startup?</h2><p class="B944rW_programDescription">Get 100k free API credits, hands-on support from our team, and help bringing your product to market.</p><a class="QdTX5q_button QdTX5q_secondary B944rW_programButton" href="/startups"><span class="QdTX5q_content"><span class="QdTX5q_label">Join the program</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div><div class="B944rW_programArt" aria-hidden="true"><svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="B944rW_programIcon" aria-hidden="true"><path d="M128,176 L80,128 L143.1,64.9 C168,40 197.5,39.4 208.4,40.1 A8,8 0 0 1 215.9,47.6 C216.6,58.5 216,88 191.1,112.9 Z"></path><path d="M136,72 H74.35 A8,8 0 0 0 68.7,74.34 L34.35,108.69 A8,8 0 0 0 38.88,122.26 L80,128"></path><path d="M184,120 V181.65 A8,8 0 0 1 181.66,187.3 L147.31,221.65 A8,8 0 0 1 133.74,217.12 L128,176"></path><path d="M94.56,187.82 C90.69,196.31 77.65,216 40,216 C40,178.35 59.69,165.31 68.18,161.44"></path></svg></div></div><div class="B944rW_programCard" style="--plan-accent:var(--color-lav)"><div class="B944rW_programContent"><h2 class="B944rW_programHeading">Free for students</h2><p class="B944rW_programDescription">We&#x27;re dedicated to supporting the pursuit of knowledge
by offering our service at no cost for students.</p><a href="https://help.tavily.com/articles/6606514713-student-account" target="_blank" rel="noopener noreferrer" class="QdTX5q_button QdTX5q_secondary B944rW_programButton"><span class="QdTX5q_content"><span class="QdTX5q_label">Start exploring</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div><div class="B944rW_programArt" aria-hidden="true"><svg viewBox="0 0 256 256" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="B944rW_programIcon" aria-hidden="true"><path d="M8,96 L128,32 L248,96 L128,160 Z"></path><path d="M128,96 L184,126 V240"></path><path d="M40,117.33 V166.29 A8,8 0 0 0 42,171.63 C55.65,186.88 84.5,208 128,208 C148,208 167,203 184,194.5"></path><path d="M216,117.33 V166.29 A8,8 0 0 1 214,171.63 A107.5,107.5 0 0 1 184,194.5"></path></svg></div></div></div></div></section></div><div class="page-module"><section class="ZOcGfW_faq "><div class="ZOcGfW_container"><div class="ZOcGfW_headerSection "><p class="ZOcGfW_eyebrow">/faq</p><h3 class="Mcjc0W_h3 ZOcGfW_heading">Frequently asked questions</h3><p class="ZOcGfW_description">If you have any questions, please reach out to our team!</p><a class="QdTX5q_button QdTX5q_primary ZOcGfW_contactButton" href="/contact"><span class="QdTX5q_content"><span class="QdTX5q_label">Contact us</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div><div class="ZOcGfW_faqList"><div data-faq-key="acc9bb359811" class="ZOcGfW_faqItem "><button id="faq-question-acc9bb359811" class="ZOcGfW_faqQuestion" aria-expanded="false" aria-controls="faq-answer-acc9bb359811"><span class="ZOcGfW_questionText">How do I start using Tavily and get an API key?</span><span class="ZOcGfW_indicator" aria-hidden="true"><svg viewBox="0 0 22 22" width="22" height="22" fill="none"><circle cx="11" cy="11" r="10.25" stroke="currentColor" stroke-width="1.2"></circle><path d="M6.5 11h9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path><path class="ZOcGfW_indicatorStem" d="M11 6.5v9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg></span></button><div id="faq-answer-acc9bb359811" role="region" aria-labelledby="faq-question-acc9bb359811" class="ZOcGfW_faqAnswerWrap"><div class="ZOcGfW_faqAnswerClip"><div class="ZOcGfW_faqAnswer"><p>Sign up for a free account and get your API key from the dashboard, this key authenticates all API requests.</p><p>Install the SDK (e.g., Python or JavaScript) and plug in your API key to start making calls.You start with 1,000 free API credits per month with no credit card required.</p></div></div></div></div><div data-faq-key="6f42a7ed7e7b380ce5f1cc72b0041499" class="ZOcGfW_faqItem "><button id="faq-question-6f42a7ed7e7b380ce5f1cc72b0041499" class="ZOcGfW_faqQuestion" aria-expanded="false" aria-controls="faq-answer-6f42a7ed7e7b380ce5f1cc72b0041499"><span class="ZOcGfW_questionText">When do my monthly API credits reset?</span><span class="ZOcGfW_indicator" aria-hidden="true"><svg viewBox="0 0 22 22" width="22" height="22" fill="none"><circle cx="11" cy="11" r="10.25" stroke="currentColor" stroke-width="1.2"></circle><path d="M6.5 11h9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path><path class="ZOcGfW_indicatorStem" d="M11 6.5v9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg></span></button><div id="faq-answer-6f42a7ed7e7b380ce5f1cc72b0041499" role="region" aria-labelledby="faq-question-6f42a7ed7e7b380ce5f1cc72b0041499" class="ZOcGfW_faqAnswerWrap"><div class="ZOcGfW_faqAnswerClip"><div class="ZOcGfW_faqAnswer"><p>Your API credits reset on the first day of each month, regardless of the billing date. This ensures you start each month with a clean slate of credits to use for your searches.</p></div></div></div></div><div data-faq-key="9fb1a9b98c8163a1313dd7c57b8534f7" class="ZOcGfW_faqItem "><button id="faq-question-9fb1a9b98c8163a1313dd7c57b8534f7" class="ZOcGfW_faqQuestion" aria-expanded="false" aria-controls="faq-answer-9fb1a9b98c8163a1313dd7c57b8534f7"><span class="ZOcGfW_questionText">What is an API credit and how is usage calculated?</span><span class="ZOcGfW_indicator" aria-hidden="true"><svg viewBox="0 0 22 22" width="22" height="22" fill="none"><circle cx="11" cy="11" r="10.25" stroke="currentColor" stroke-width="1.2"></circle><path d="M6.5 11h9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path><path class="ZOcGfW_indicatorStem" d="M11 6.5v9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg></span></button><div id="faq-answer-9fb1a9b98c8163a1313dd7c57b8534f7" role="region" aria-labelledby="faq-question-9fb1a9b98c8163a1313dd7c57b8534f7" class="ZOcGfW_faqAnswerWrap"><div class="ZOcGfW_faqAnswerClip"><div class="ZOcGfW_faqAnswer"><p>API credits are consumed based on the type of request you make (such as search, extract, or crawl). More advanced or higher-volume requests use more credits. Full usage details are available in the documentation.</p></div></div></div></div><div data-faq-key="0b8d92f65a293e6c45befca084b4c893" class="ZOcGfW_faqItem "><button id="faq-question-0b8d92f65a293e6c45befca084b4c893" class="ZOcGfW_faqQuestion" aria-expanded="false" aria-controls="faq-answer-0b8d92f65a293e6c45befca084b4c893"><span class="ZOcGfW_questionText">What happens if I run out of credits?</span><span class="ZOcGfW_indicator" aria-hidden="true"><svg viewBox="0 0 22 22" width="22" height="22" fill="none"><circle cx="11" cy="11" r="10.25" stroke="currentColor" stroke-width="1.2"></circle><path d="M6.5 11h9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path><path class="ZOcGfW_indicatorStem" d="M11 6.5v9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path></svg></span></button><div id="faq-answer-0b8d92f65a293e6c45befca084b4c893" role="region" aria-labelledby="faq-question-0b8d92f65a293e6c45befca084b4c893" class="ZOcGfW_faqAnswerWrap"><div class="ZOcGfW_faqAnswerClip"><div class="ZOcGfW_faqAnswer"><p>If you exhaust your monthly credits, requests will stop until your credits reset or you upgrade to a paid plan. Paid plans provide higher monthly limits and uninterrupted usage.</p></div></div></div></div></div></div></section></div></main><!--$--><!--/$--><footer class="_6wQ4pq_footer "><div class="_6wQ4pq_rays"><div class="cWzlCa_container" aria-hidden="true"></div></div><div class="_6wQ4pq_hero"><div class="_6wQ4pq_heroBackground"><img alt="" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-fit:cover;color:transparent" sizes="100vw" srcSet="/_next/image?url=%2Ffooter-hero-bg.webp&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ffooter-hero-bg.webp&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=%2Ffooter-hero-bg.webp&amp;w=3840&amp;q=75"/></div><div class="_6wQ4pq_heroContent"><h2 class="_6wQ4pq_heroHeading">Power your AI with real-time web search</h2><div class="_6wQ4pq_heroButtons"><a href="https://app.tavily.com/home" target="_blank" rel="noopener noreferrer" class="QdTX5q_button QdTX5q_primary"><span class="QdTX5q_content"><span class="QdTX5q_label">Try it out</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a><a href="https://docs.tavily.com" target="_blank" rel="noopener noreferrer" class="QdTX5q_button QdTX5q_secondary"><span class="QdTX5q_content"><span class="QdTX5q_label">Explore API docs</span></span><span class="QdTX5q_border" aria-hidden="true"></span></a></div></div></div><div class="_6wQ4pq_content"><div cla