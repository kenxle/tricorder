{
  "name": "tricorder",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "generate:api": "bash bin/generate-api",
    "check:api": "bash bin/generate-api --check",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --ui=tui",
    "start": "turbo run start",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@tricorder/web",
    "dev:mobile": "turbo run dev --filter=@tricorder/mobile --ui=tui",
    "lint": "pnpm check && turbo run lint",
    "build:ios": "pnpm --filter @tricorder/mobile build:ios",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:mobile:device": "pnpm --filter @tricorder/mobile dev:device"
  },
  "devDependencies": {
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "turbo": "2.11.10",
    "ultracite": "8.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.9.0",
  "intent": {
    "skills": [
      "*"
    ]
  }
}
