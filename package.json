{
  "name": "tricorder",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@tricorder/web"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
