{
  "name": "tricorder",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev --ui=tui",
    "start": "turbo run start",
    "test": "turbo run test",
    "dev:web": "turbo run dev --filter=@tricorder/web",
    "dev:mobile": "turbo run dev --filter=@tricorder/mobile --ui=tui",
    "lint": "turbo run lint",
    "build:ios": "pnpm --filter @tricorder/mobile build:ios"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
